// =====================================================
// Planejamento Financeiro App
// Domain Model - Initial Version
// =====================================================

// =====================================================
// Prisma Configuration
// =====================================================

generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =====================================================
// ENUMS
// =====================================================

enum FamilyRole {
  OWNER
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AccountType {
  CHECKING
  SAVINGS
  CASH
  INVESTMENT
  OTHER
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum Currency {
  BRL
  USD
  EUR
}

enum WeekStartDay {
  SUNDAY
  MONDAY
}

enum NotificationLevel {
  NONE
  IMPORTANT
  ALL
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELED
}

// =====================================================
// FAMILY
// =====================================================

model Family {
  id String @id @default(uuid())

  name String

  ownerId String

  owner User @relation("FamilyOwner", fields: [ownerId], references: [id])

  members FamilyMember[] @relation("FamilyMembers")

  currentUserSettings UserSettings[] @relation("UserCurrentFamily")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@map("families")
}

// =====================================================
// USER
// =====================================================

model User {
  id String @id @default(uuid())

  name String

  email String @unique

  passwordHash String?

  image String?

  settings UserSettings?

  status UserStatus @default(ACTIVE)

  familyMembers FamilyMember[] @relation("UserFamilyMembers")

  ownedFamilies Family[] @relation("FamilyOwner")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@map("users")
}

// =====================================================
// FAMILY MEMBER
// =====================================================

model FamilyMember {
  id String @id @default(uuid())

  familyId String

  userId String

  role FamilyRole @default(MEMBER)

  family Family @relation("FamilyMembers", fields: [familyId], references: [id], onDelete: Cascade)

  user User @relation("UserFamilyMembers", fields: [userId], references: [id], onDelete: Cascade)

  accounts Account[] @relation("FamilyMemberAccounts")

  transactions Transaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@unique([familyId, userId])
  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

// =====================================================
// ACCOUNT
// =====================================================

model Account {
  id String @id @default(uuid())

  displayOrder Int @default(0)

  familyMemberId String

  name String

  description String?

  type AccountType @default(CHECKING)

  initialBalanceDate DateTime

  initialBalance Decimal @db.Decimal(12, 2)

  currency Currency @default(BRL)

  icon String?

  color String?

  isDefault Boolean @default(false)

  isActive Boolean @default(true)

  familyMember FamilyMember @relation("FamilyMemberAccounts", fields: [familyMemberId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([familyMemberId])
  @@map("accounts")
}

//==================================
// TransactionStatus
//==================================
model Transaction {
  id String @id @default(uuid())

  familyMemberId String

  accountId String

  description String

  notes String?

  amount Decimal @db.Decimal(12, 2)

  type TransactionType

  status TransactionStatus @default(PENDING)

  transactionDate DateTime

  effectiveDate DateTime?

  familyMember FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([transactionDate])
  @@index([accountId])
  @@index([familyMemberId])
  @@map("transactions")
}

//==================================
// USERSETTINGS
//==================================

model UserSettings {
  id String @id @default(uuid())

  userId String @unique

  currentFamilyId String?

  currency Currency @default(BRL)

  locale String @default("pt-BR")

  theme Theme @default(SYSTEM)

  weekStartsOn WeekStartDay @default(SUNDAY)

  notificationLevel NotificationLevel @default(IMPORTANT)

  dayOfTightnessAlert Boolean @default(true)

  minimumReserve Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  currentFamily Family? @relation("UserCurrentFamily", fields: [currentFamilyId], references: [id], onDelete: SetNull)

  @@map("user_settings")
}
